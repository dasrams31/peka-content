    {
      "badge": "COBA DULU #02",
      "headline": [
        "KABEL NYANGKUT",
        "DI FOTO PRODUK?"
      ],
      "kind": "hook",
      "mascot": {
        "bottom": 470,
        "side": "right",
        "width": 260
      },
      "narration": "Foto produkku rusak gara-gara kabel. Sepatu putih di meja kayu, kabel hitam kusut numpuk di depannya. Jadi aku coba hapus kabelnya pakai Cleanup.pictures, gratis tanpa daftar.",
      "pose": "wave",
      "sub": "Aku coba hapus kabelnya, gratis."
    },
    {
      "kind": "beat",
      "lines": [
        "Buka cleanup.pictures",
        "Sapu kabelnya, AI langsung kerja"
      ],
      "mascot": {
        "bottom": 470,
        "flip": true,
        "side": "left",
        "width": 170
      },
      "narration": "Caranya: buka cleanup.pictures, upload fotonya, sapu kabelnya pakai kuas. Nggak ada tombol hapus, AI-nya langsung kerja tiap sapuan, 5 sampai 15 detik.",
      "pose": "present",
      "stat": "4 MENIT",
      "stat_label": "3 sapuan, dari upload sampai unduh"
    },
    {
      "kind": "beat",
      "lines": [
        "Sebelum: kabel kusut nutupin sepatu",
        "Sesudah: meja bersih, sol transparan"
      ],
      "mascot": {
        "bottom": 470,
        "side": "right",
        "width": 170
      },
      "narration": "Tiga sapuan, empat menit. Kabel di meja hilang, kayunya balik bersih. Tapi sol sepatunya ikut lumer, transparan kayak asap. Kabel yang nempel di sepatu kehapus bareng solnya.",
      "pose": "base",
      "stat": "KABEL HILANG",
      "stat_label": "tapi sol sepatu ikut lumer"
    },
    {
      "badge": "JUJUR AJA",
      "kind": "beat",
      "lines": [
        "Belum bisa buat katalog,",
        "sisa 2 helai kabel di ujung sepatu",
        "plus solnya lumer kayak asap.",
        "Sapu jangan kena produk."
      ],
      "mascot": {
        "bottom": 470,
        "flip": true,
        "side": "left",
        "width": 170
      },
      "narration": "Hasil ini belum bisa dipakai buat katalog. Masih sisa dua helai kabel di ujung sepatu. Pelajarannya: sapunya jangan kena produk, kabel yang nempel di produk mending foto ulang.",
      "pose": "base"
    },
    {
      "follow": "Follow <b>@peka.ai.id</b> kalau kontennya kepakai.",
      "headline": [
        "Kamu mau coba",
        "hapus apa",
        "dulu?"
      ],
      "kind": "close",
      "mascot": {
        "bottom": 620,
        "side": "right",
        "width": 180
      },
      "narration": "Langkah pertamamu: buka cleanup.pictures, upload satu fotomu, sapu objek ganggunya tapi jangan kena produknya. Kamu mau coba buat foto apa dulu, hapus kabel atau hapus orang lewat?",
      "pose": "wave",
      "shortlink": "s.peka.ai.id/Ua3ePE"
    }
